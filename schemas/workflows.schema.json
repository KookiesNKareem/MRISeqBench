{
  "$defs": {
    "WorkflowStage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "request": {
          "minLength": 1,
          "title": "Request",
          "type": "string"
        },
        "patch": {
          "additionalProperties": true,
          "minProperties": 1,
          "title": "Patch",
          "type": "object"
        }
      },
      "required": [
        "id",
        "request",
        "patch"
      ],
      "title": "WorkflowStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "initial_patch": {
      "additionalProperties": true,
      "title": "Initial Patch",
      "type": "object"
    },
    "task": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
          "type": "string"
        },
        {
          "pattern": "^T[1-4]\\.[1-9][0-9]*@[1-9][0-9]*$",
          "type": "string"
        }
      ],
      "title": "Task"
    },
    "qualification": {
      "const": "draft",
      "default": "draft",
      "title": "Qualification",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/WorkflowStage"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "id",
    "version",
    "task",
    "stages"
  ],
  "title": "Workflow",
  "type": "object"
}
