{
  "$defs": {
    "Agent": {
      "additionalProperties": false,
      "properties": {
        "uses_model": {
          "default": true,
          "title": "Uses Model",
          "type": "boolean"
        },
        "pi_version": {
          "default": "0.87.0",
          "title": "Pi Version",
          "type": "string"
        },
        "auto_compaction": {
          "default": false,
          "title": "Auto Compaction",
          "type": "boolean"
        },
        "adapter": {
          "default": "command",
          "enum": [
            "command",
            "pi"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "timeout_s": {
          "default": 60,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        },
        "sandbox": {
          "$ref": "#/$defs/SandboxConfig"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Environment",
          "type": "object"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "title": "Agent",
      "type": "object"
    },
    "ApiProxyConfig": {
      "additionalProperties": false,
      "properties": {
        "provider_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Endpoint"
        },
        "temperature": {
          "default": 0.6,
          "maximum": 2,
          "minimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "top_p": {
          "default": 0.95,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Top P",
          "type": "number"
        },
        "reasoning_effort": {
          "default": "medium",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "title": "Reasoning Effort",
          "type": "string"
        },
        "max_output_tokens": {
          "default": 16384,
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "upstream_url": {
          "default": "https://openrouter.ai/api/v1",
          "title": "Upstream Url",
          "type": "string"
        },
        "key_env": {
          "default": "OPENROUTER_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Key Env",
          "type": "string"
        },
        "allowed_routes": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Routes",
          "type": "array"
        },
        "timeout_s": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        },
        "max_request_bytes": {
          "default": 8388608,
          "exclusiveMinimum": 0,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_campaign_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Campaign Usd"
        },
        "max_trial_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Trial Usd"
        }
      },
      "title": "ApiProxyConfig",
      "type": "object"
    },
    "ArmRuntime": {
      "additionalProperties": false,
      "properties": {
        "author_image": {
          "minLength": 1,
          "pattern": "^[^\\s]+$",
          "title": "Author Image",
          "type": "string"
        },
        "simulator_image": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "^[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Simulator Image"
        },
        "probe_timeout_s": {
          "default": 120,
          "exclusiveMinimum": 0,
          "title": "Probe Timeout S",
          "type": "number"
        },
        "simulation_timeout_s": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Simulation Timeout S",
          "type": "number"
        },
        "julia_heap_size_hint_mb": {
          "anyOf": [
            {
              "minimum": 32,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Julia Heap Size Hint Mb"
        },
        "author_memory_mb": {
          "default": 2048,
          "minimum": 256,
          "title": "Author Memory Mb",
          "type": "integer"
        }
      },
      "required": [
        "author_image"
      ],
      "title": "ArmRuntime",
      "type": "object"
    },
    "Backend": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "timeout_s": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "command"
      ],
      "title": "Backend",
      "type": "object"
    },
    "Concurrency": {
      "additionalProperties": false,
      "properties": {
        "agents": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Agents",
          "type": "integer"
        },
        "graders": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Graders",
          "type": "integer"
        }
      },
      "title": "Concurrency",
      "type": "object"
    },
    "FeedbackConfig": {
      "additionalProperties": false,
      "properties": {
        "max_submission_bytes": {
          "default": 16777216,
          "exclusiveMinimum": 0,
          "title": "Max Submission Bytes",
          "type": "integer"
        },
        "timeout_s": {
          "default": 300,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "title": "FeedbackConfig",
      "type": "object"
    },
    "SandboxConfig": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "auto",
          "enum": [
            "auto",
            "macos",
            "bubblewrap",
            "docker",
            "none"
          ],
          "title": "Backend",
          "type": "string"
        },
        "read_paths": {
          "items": {
            "type": "string"
          },
          "title": "Read Paths",
          "type": "array"
        },
        "deny_paths": {
          "items": {
            "type": "string"
          },
          "title": "Deny Paths",
          "type": "array"
        },
        "network_ports": {
          "items": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "title": "Network Ports",
          "type": "array"
        }
      },
      "title": "SandboxConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "suite": {
      "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
      "title": "Suite",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "repeats": {
      "default": 1,
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Repeats",
      "type": "integer"
    },
    "max_submissions": {
      "default": 3,
      "maximum": 3,
      "minimum": 1,
      "title": "Max Submissions",
      "type": "integer"
    },
    "agent": {
      "$ref": "#/$defs/Agent"
    },
    "backend": {
      "anyOf": [
        {
          "$ref": "#/$defs/Backend"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feedback": {
      "$ref": "#/$defs/FeedbackConfig"
    },
    "api_proxy": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApiProxyConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "submission_mode": {
      "default": "submit",
      "enum": [
        "file",
        "submit"
      ],
      "title": "Submission Mode",
      "type": "string"
    },
    "arm": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Arm"
    },
    "arm_runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArmRuntime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "concurrency": {
      "$ref": "#/$defs/Concurrency"
    },
    "retries_after_spend": {
      "default": 1,
      "maximum": 5,
      "minimum": 0,
      "title": "Retries After Spend",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "suite",
    "agent"
  ],
  "title": "Experiment",
  "type": "object"
}
