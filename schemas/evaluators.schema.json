{
  "$defs": {
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        }
      },
      "required": [
        "name"
      ],
      "title": "Metric",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "scope": {
      "enum": [
        "benchmark",
        "smoke"
      ],
      "title": "Scope",
      "type": "string"
    },
    "calibrated": {
      "title": "Calibrated",
      "type": "boolean"
    },
    "reconstruction": {
      "enum": [
        "cartesian_fft@1",
        "none"
      ],
      "title": "Reconstruction",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Metrics",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "scope",
    "calibrated",
    "reconstruction",
    "metrics"
  ],
  "title": "Evaluation",
  "type": "object"
}
