{
  "$defs": {
    "HardwareProvenance": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "title": "System",
          "type": "string"
        },
        "source_url": {
          "pattern": "^https://\\S+$",
          "title": "Source Url",
          "type": "string"
        },
        "accessed_on": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "title": "Accessed On",
          "type": "string"
        },
        "notes": {
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "system",
        "source_url",
        "accessed_on",
        "notes"
      ],
      "title": "HardwareProvenance",
      "type": "object"
    },
    "SARModel": {
      "additionalProperties": false,
      "description": "Fixed benchmark load, independent of the imaging phantom geometry.",
      "properties": {
        "model": {
          "const": "homogeneous_sphere_v1",
          "title": "Model",
          "type": "string"
        },
        "radius_m": {
          "exclusiveMinimum": 0,
          "title": "Radius M",
          "type": "number"
        },
        "conductivity_S_per_m": {
          "exclusiveMinimum": 0,
          "title": "Conductivity S Per M",
          "type": "number"
        },
        "density_kg_per_m3": {
          "exclusiveMinimum": 0,
          "title": "Density Kg Per M3",
          "type": "number"
        },
        "whole_body_limit_W_per_kg": {
          "exclusiveMinimum": 0,
          "title": "Whole Body Limit W Per Kg",
          "type": "number"
        }
      },
      "required": [
        "model",
        "radius_m",
        "conductivity_S_per_m",
        "density_kg_per_m3",
        "whole_body_limit_W_per_kg"
      ],
      "title": "SARModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "provenance": {
      "anyOf": [
        {
          "$ref": "#/$defs/HardwareProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "field_strength_T": {
      "exclusiveMinimum": 0,
      "title": "Field Strength T",
      "type": "number"
    },
    "sar": {
      "$ref": "#/$defs/SARModel"
    },
    "max_gradient_mT_per_m": {
      "exclusiveMinimum": 0,
      "title": "Max Gradient Mt Per M",
      "type": "number"
    },
    "max_slew_T_per_m_per_s": {
      "exclusiveMinimum": 0,
      "title": "Max Slew T Per M Per S",
      "type": "number"
    },
    "max_b1_uT": {
      "exclusiveMinimum": 0,
      "title": "Max B1 Ut",
      "type": "number"
    },
    "rf_dead_time_us": {
      "exclusiveMinimum": 0,
      "title": "Rf Dead Time Us",
      "type": "number"
    },
    "rf_ringdown_time_us": {
      "exclusiveMinimum": 0,
      "title": "Rf Ringdown Time Us",
      "type": "number"
    },
    "adc_dead_time_us": {
      "exclusiveMinimum": 0,
      "title": "Adc Dead Time Us",
      "type": "number"
    },
    "gradient_raster_us": {
      "exclusiveMinimum": 0,
      "title": "Gradient Raster Us",
      "type": "number"
    },
    "rf_raster_us": {
      "exclusiveMinimum": 0,
      "title": "Rf Raster Us",
      "type": "number"
    },
    "adc_raster_us": {
      "exclusiveMinimum": 0,
      "title": "Adc Raster Us",
      "type": "number"
    },
    "block_raster_us": {
      "exclusiveMinimum": 0,
      "title": "Block Raster Us",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "field_strength_T",
    "sar",
    "max_gradient_mT_per_m",
    "max_slew_T_per_m_per_s",
    "max_b1_uT",
    "rf_dead_time_us",
    "rf_ringdown_time_us",
    "adc_dead_time_us",
    "gradient_raster_us",
    "rf_raster_us",
    "adc_raster_us",
    "block_raster_us"
  ],
  "title": "Hardware",
  "type": "object"
}
