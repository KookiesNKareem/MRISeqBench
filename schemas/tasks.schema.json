{
  "$defs": {
    "ApplicationSpec": {
      "additionalProperties": false,
      "properties": {
        "inversion_time_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inversion Time Ms"
        },
        "inversion_times_ms": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Inversion Times Ms",
          "type": "array"
        },
        "preparation_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preparation Duration Ms"
        },
        "preparation_durations_ms": {
          "items": {
            "minimum": 0,
            "type": "number"
          },
          "title": "Preparation Durations Ms",
          "type": "array"
        },
        "saturation_offset_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Saturation Offset Hz"
        },
        "diffusion_b_s_per_mm2": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Diffusion B S Per Mm2"
        },
        "labeling_duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Labeling Duration Ms"
        },
        "post_label_delay_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Post Label Delay Ms"
        },
        "flip_angle_schedule_deg": {
          "items": {
            "exclusiveMinimum": 0,
            "maximum": 180,
            "type": "number"
          },
          "title": "Flip Angle Schedule Deg",
          "type": "array"
        },
        "tr_schedule_ms": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Tr Schedule Ms",
          "type": "array"
        },
        "echo_times_ms": {
          "items": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "title": "Echo Times Ms",
          "type": "array"
        }
      },
      "title": "ApplicationSpec",
      "type": "object"
    },
    "ReadoutSpec": {
      "additionalProperties": false,
      "properties": {
        "shots": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shots"
        },
        "echo_train_length": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Echo Train Length"
        },
        "interleaves": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interleaves"
        },
        "spokes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spokes"
        },
        "dwell_us": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dwell Us"
        },
        "bandwidth_hz_per_pixel": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandwidth Hz Per Pixel"
        },
        "turns": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turns"
        },
        "rings": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rings"
        },
        "rosette_lobes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rosette Lobes"
        },
        "blade_width_lines": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blade Width Lines"
        },
        "echo_spacing_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Echo Spacing Ms"
        },
        "center_out": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center Out"
        }
      },
      "title": "ReadoutSpec",
      "type": "object"
    },
    "SamplingSpec": {
      "additionalProperties": false,
      "properties": {
        "acceleration": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acceleration"
        },
        "partial_fourier_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.5,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Fourier Fraction"
        },
        "calibration_lines": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Lines"
        },
        "multiband_factor": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Multiband Factor"
        },
        "mask_seed": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mask Seed"
        },
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "uniform",
                "variable_density",
                "poisson_disc",
                "elliptical",
                "asymmetric_echo",
                "reduced_fov"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pattern"
        },
        "caipi_shift": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caipi Shift"
        },
        "asymmetric_echo_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.5,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asymmetric Echo Fraction"
        },
        "reduced_fov_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reduced Fov Fraction"
        }
      },
      "title": "SamplingSpec",
      "type": "object"
    },
    "SequenceSpec": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "S1",
            "S2",
            "S3",
            "S4"
          ],
          "title": "Level",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "enum": [
              "spoiled_gre",
              "spin_echo",
              "bssfp",
              "cartesian",
              "spiral",
              "radial",
              "stack_of_stars",
              "propeller",
              "ute",
              "epi",
              "multi_shot",
              "tse",
              "rare",
              "grase",
              "undersampling",
              "grappa",
              "sense",
              "caipirinha",
              "compressed_sensing",
              "variable_density",
              "poisson_disc",
              "partial_fourier",
              "reduced_fov",
              "elliptical_kspace",
              "adiabatic",
              "inversion",
              "t2_preparation",
              "multi_contrast",
              "mapping",
              "triggering",
              "gating"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "matrix": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "integer"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Matrix"
        },
        "fov_mm": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              ],
              "type": "array"
            }
          ],
          "title": "Fov Mm"
        },
        "te_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tr_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "duration_s": {
          "exclusiveMinimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "flip_angle_deg": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flip Angle Deg"
        },
        "readout": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReadoutSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sampling": {
          "anyOf": [
            {
              "$ref": "#/$defs/SamplingSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "temporal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemporalSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "application": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplicationSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "level",
        "capabilities",
        "matrix",
        "fov_mm",
        "duration_s"
      ],
      "title": "SequenceSpec",
      "type": "object"
    },
    "Submission": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "pulseq",
          "default": "pulseq",
          "title": "Format",
          "type": "string"
        },
        "file": {
          "const": "sequence.seq",
          "default": "sequence.seq",
          "title": "File",
          "type": "string"
        }
      },
      "title": "Submission",
      "type": "object"
    },
    "TemporalSpec": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "exclusiveMinimum": 0,
          "title": "Frames",
          "type": "integer"
        },
        "frame_duration_ms": {
          "exclusiveMinimum": 0,
          "title": "Frame Duration Ms",
          "type": "number"
        },
        "ordering": {
          "enum": [
            "sequential",
            "interleaved",
            "golden_angle"
          ],
          "title": "Ordering",
          "type": "string"
        },
        "view_sharing_window": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "View Sharing Window"
        },
        "center_fraction": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center Fraction"
        },
        "trigger_source": {
          "anyOf": [
            {
              "const": "ecg",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Source"
        },
        "rr_interval_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rr Interval Ms"
        },
        "trigger_delay_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trigger Delay Ms"
        },
        "acquisition_window_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acquisition Window Ms"
        }
      },
      "required": [
        "frames",
        "frame_duration_ms",
        "ordering"
      ],
      "title": "TemporalSpec",
      "type": "object"
    },
    "Timing": {
      "additionalProperties": false,
      "properties": {
        "target": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "tolerance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        },
        "max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        }
      },
      "title": "Timing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Id",
      "type": "string"
    },
    "version": {
      "default": 1,
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "sequence": {
      "$ref": "#/$defs/SequenceSpec"
    },
    "prompt_mode": {
      "const": "detailed",
      "default": "detailed",
      "title": "Prompt Mode",
      "type": "string"
    },
    "identity_requirements": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 0,
      "title": "Identity Requirements",
      "type": "array"
    },
    "object": {
      "default": "cardiac_2d@1",
      "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
      "title": "Object",
      "type": "string"
    },
    "hardware": {
      "default": "high_performance@1",
      "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
      "title": "Hardware",
      "type": "string"
    },
    "evaluation": {
      "pattern": "^[a-z][a-z0-9_]*@[1-9][0-9]*$",
      "title": "Evaluation",
      "type": "string"
    },
    "submission": {
      "$ref": "#/$defs/Submission"
    }
  },
  "required": [
    "id",
    "objective",
    "sequence",
    "evaluation"
  ],
  "title": "Task",
  "type": "object"
}
